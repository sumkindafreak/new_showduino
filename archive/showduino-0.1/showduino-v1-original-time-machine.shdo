{
  "schema": "showduino-production-v2",
  "project": {
    "id": "showduino-v1-original-time-machine",
    "name": "Showduino V1 — Original Time Machine",
    "description": "Preservation-grade SHDO v2 reconstruction of the original Showduino 0.1 time-machine attraction controller.",
    "version": "0.1.0-migration",
    "author": "Toby Brandon",
    "createdAt": "2026-09-19T00:00:00+01:00",
    "updatedAt": "2026-09-19T00:00:00+01:00",
    "tags": [
      "showduino-history",
      "time-machine",
      "migration",
      "reference-production"
    ]
  },
  "architecture": {
    "runtimeAuthority": "esp32-p4-show-engine",
    "operator": "esp32-s3-director",
    "transport": "esp32-s3-comms-controller",
    "nodeAddressing": "logical-device-id"
  },
  "compatibility": {
    "shdoMajor": 2,
    "notes": [
      "Preservation migration from archived Showduino 0.1 Arduino controller.",
      "Authoring document intentionally records original behavior even where current Stage persistent runtime cannot yet execute every action kind.",
      "Physical pins from the original controller are provenance only; creative actions target logical device IDs."
    ]
  },
  "devices": [
