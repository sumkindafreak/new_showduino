#ifndef SHOWDUINO_LOCAL_SECRETS_EXAMPLE_H
#define SHOWDUINO_LOCAL_SECRETS_EXAMPLE_H

/*
 * Copy this file to LocalSecrets.h in the same sketch folder and customise.
 * LocalSecrets.h is gitignored — never commit venue passwords or tokens.
 *
 *   firmware/s3-comms-controller/ShowduinoS3CommsController/LocalSecrets.h
 *
 * SoftAP WPA2 password (min 8 chars for WPA2-PSK).
 * Optional control token: when defined and non-empty, POSTs to /api/command
 * must include header X-Showduino-Token matching this value.
 */

#define SHOWDUINO_WEBUI_AP_PASSWORD "change-me-before-venue"

/* Uncomment to require a control token for /api/command (and other mutating APIs): */
/* #define SHOWDUINO_WEBUI_CONTROL_TOKEN "long-random-token" */

/* Remote emergency CLEAR from the browser is not available (MISSION 001K removed
 * SHOWDUINO_WEBUI_ALLOW_EMERGENCY_CLEAR). Assert (STOP) remains available. Clear
 * needs the enrolled Director's signed request and confirm. */

#endif
