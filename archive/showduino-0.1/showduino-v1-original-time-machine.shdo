  "assets": [],
  "safety": {
    "policy": "firmware-authoritative",
    "emergency": {
      "stopTimeline": true,
      "pixelOverride": "all-white",
      "requiresManualClear": true,
      "autoResume": false
    },
    "productionCannotDisable": true
  },
  "globalSettings": {
    "defaultAudioVolume": 30,
    "timebase": "milliseconds"
  },
  "config": {
    "migrationMode": "preserve-executed-behavior",
    "legacySource": "archive/showduino-0.1/original-time-machine-controller.ino",
    "ambiguityPolicy": "do-not-silently-correct",
    "notes": [
      "Legacy relay outputs are active-low: LOW=active, HIGH=inactive.",
      "Legacy track comments and executed track numbers are both retained when they disagree.",
      "Continuous legacy effects will be represented as named lighting intents before runtime compilation."
    ]
  },
  "package": {
    "format": "showduino-production",
    "version": 2
  },
  "metadata": {
    "provenance": {
      "sourceVersion": "SHOWDUINO VER 0.1",
      "migrationBranch": "showduino-v1-original-show"
    },
    "migrationStatus": "device-registry-and-scene-skeleton",
    "knownAmbiguities": [
      {
        "id": "water-whales-track",
        "note": "Scene 5 executes ambient track 23 while source comment says track 22 (whales). Requires operator confirmation before asset binding."
      },
      {
        "id": "sc8-unused",
        "note": "SC8 input exists in hardware declarations but no scene activation was found in the extracted scene flow."
      }
    ]
  }
