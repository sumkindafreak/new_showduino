{
  "schema": "showduino-production-v2",
  "package": {
    "format": "showduino-production",
    "version": 2,
    "architecture": "director-comms-p4-nodes",
    "runtimeAuthority": "esp32-p4-show-engine"
  },
  "project": {
    "id": "time_machine_first_journey",
    "name": "Time Machine - The First Journey",
    "description": "Startup, prehistoric encounter, underwater arrival and a final electrical fault. Three minutes.",
    "author": "Toby",
    "version": "1.1.0",
    "revision": 2,
    "duration": 180000
  },
  "architecture": {
    "version": 1,
    "creator": "showduino-hand-authored",
    "runtimeAuthority": "esp32-p4-show-engine",
    "operator": "esp32-s3-director",
    "transport": "esp32-s3-comms-controller",
    "nodeAddressing": "logical-device-id"
  },
  "compatibility": {
    "shdoMajor": 2,
    "minimumStudioVersion": "2.0.0",
    "minimumRuntimeProtocol": 1
  },
  "safety": {
    "runtimeAuthority": "esp32-p4-show-engine",
    "policy": "firmware-authoritative",
    "productionCannotDisable": true,
    "emergency": {
      "stopTimeline": true,
      "pixelOverride": "all-white",
      "requiresManualClear": true,
      "autoResume": false,
      "productionCannotDisable": true
    }
  },
  "devices": [
    {
      "id": "p4-show-pixels",
      "name": "P4 Show Pixels",
      "type": "p4-pixel-line",
      "enabled": true,
      "binding": {
        "route": "p4-show-pixels",
        "nodeId": "p4",
        "pixelStart": 0,
        "pixelCount": 10
      }
    },
    {
      "id": "pixel-node-1",
