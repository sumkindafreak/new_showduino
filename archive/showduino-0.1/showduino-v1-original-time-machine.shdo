{
  "schema": "showduino-production-v2",
  "package": {
    "format": "showduino-production",
    "version": 2,
    "architecture": "director-comms-p4-nodes",
    "runtimeAuthority": "esp32-p4-show-engine"
  },
  "project": {
    "id": "showduino-v1-original-time-machine",
    "name": "Showduino V1 — Original Time Machine",
    "description": "Modern SHDO reconstruction of the original Showduino 0.1 time-machine attraction.",
    "author": "Toby Brandon",
    "version": "2.0.0",
    "revision": 4,
    "duration": 300000
  },
  "architecture": {
    "version": 1,
    "creator": "showduino-hand-authored",
    "runtimeAuthority": "esp32-p4-show-engine",
    "operator": "esp32-s3-director",
    "transport": "esp32-s3-comms-controller",
    "nodeAddressing": "logical-device-id"
  },
  "compatibility": {
    "shdoMajor": 2,
    "minimumStudioVersion": "2.0.0",
    "minimumRuntimeProtocol": 1
  },
  "safety": {
    "runtimeAuthority": "esp32-p4-show-engine",
    "policy": "firmware-authoritative",
    "productionCannotDisable": true,
    "emergency": {
      "stopTimeline": true,
      "pixelOverride": "all-white",
      "requiresManualClear": true,
      "autoResume": false,
      "productionCannotDisable": true
    }
  },
  "devices": [
    {
      "id": "audio-1",
      "name": "The Chamber Audio",
      "type": "audio-node",
      "enabled": true,
      "binding": {
        "route": "audio-node",
        "nodeId": "AUDIO-01"
      }
    },
    {
      "id": "pixels-ambience",
      "name": "Ambience Pixel Line",
      "type": "p4-pixel-line",
      "enabled": true,
      "binding": {
        "route": "p4-show-pixels",
        "nodeId": "p4"
      }
    },
    {
      "id": "pixels-machine",
      "name": "Machine Pixel Node",
      "type": "pixel-node",
      "enabled": true,
      "binding": {
        "route": "pixel-node",
        "nodeId": "LED-01"
      }
    }
  ],
  "tracks": [
    {
      "id": "track-audio",
      "name": "The Chamber Audio",
      "type": "audio",
      "enabled": true,
      "order": 0,
      "targetDeviceId": "audio-1"
    },
    {
      "id": "track-pixels-ambience",
      "name": "Ambience",
      "type": "pixel",
      "enabled": true,
      "order": 1,
      "targetDeviceId": "pixels-ambience"
