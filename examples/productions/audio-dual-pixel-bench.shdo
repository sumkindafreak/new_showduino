{
  "schema": "showduino-production-v2",
  "package": {
    "format": "showduino-production",
    "version": 2,
    "architecture": "director-comms-p4-nodes",
    "runtimeAuthority": "esp32-p4-show-engine"
  },
  "project": {
    "id": "audio_dual_pixel_bench",
    "name": "Audio + Dual Pixel Bench",
    "description": "60-second audio, Audio Node pixels and Emergency Node pixels test.",
    "author": "Showduino",
    "version": "2.0.0",
    "revision": 1,
    "duration": 60000
  },
  "architecture": {
    "version": 1,
    "creator": "showduino-hand-authored",
    "runtimeAuthority": "esp32-p4-show-engine",
    "operator": "esp32-s3-director",
    "transport": "esp32-s3-comms-controller",
    "nodeAddressing": "logical-device-id"
  },
  "compatibility": {
    "shdoMajor": 2,
    "minimumStudioVersion": "2.0.0",
    "minimumRuntimeProtocol": 1
  },
  "safety": {
    "runtimeAuthority": "esp32-p4-show-engine",
    "policy": "firmware-authoritative",
    "productionCannotDisable": true,
    "emergency": {
      "stopTimeline": true,
      "pixelOverride": "all-white",
      "requiresManualClear": true,
      "autoResume": false,
      "productionCannotDisable": true
    }
  },
  "devices": [
    {
      "id": "audio-1",
      "name": "Audio Node",
      "type": "audio-node",
      "enabled": true,
      "binding": {
        "route": "audio-node",
        "nodeId": "AUDIO-01"
      }
    },
    {
      "id": "audio-pixels",
      "name": "Audio GPIO22 pixels",
      "type": "pixel",
      "enabled": true,
      "binding": {
        "route": "audio-node-pixels",
        "pixelStart": 0,
        "pixelCount": 10
      }
    },
    {
      "id": "estop-pixels",
      "name": "Emergency Node pixels",
      "type": "pixel",
      "enabled": true,
      "binding": {
        "route": "estop-node-pixels",
        "pixelStart": 0,
        "pixelCount": 10
      }
    }
  ],
  "tracks": [
    {
      "id": "track-audio-1",
      "name": "Audio Node",
      "type": "audio",
      "enabled": true,
      "order": 0,
      "targetDeviceId": "audio-1"
    },
    {
      "id": "track-audio-pixels",
      "name": "Audio GPIO22 pixels",
      "type": "pixel",
      "enabled": true,
      "order": 1,
      "targetDeviceId": "audio-pixels"
    },
    {
      "id": "track-estop-pixels",
      "name": "Emergency Node pixels",
      "type": "pixel",
      "enabled": true,
      "order": 2,
      "targetDeviceId": "estop-pixels"
    }
  ],
  "clips": [
