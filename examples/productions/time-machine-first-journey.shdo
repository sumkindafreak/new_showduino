  "metadata": {
    "studioModel": "timeline-tracks-clips-logical-devices",
    "authoringSource": "original-time-machine-adaptation",
    "notes": "Linear 180s adaptation through the electrical jolt before wartime arrival. No emergency assertion or clear is authored. Lamp sound unverified. MOSFET channels assumed lighting at 25%. Logical node IDs LED-01/AUDIO-01/LAMP-01/MOSFET-01. P4 machine.wav is a copy of machine_only_ambience.wav. New timed-ambience firmware required.",
    "reference": "https://github.com/sumkindafreak/new_showduino/blob/main/archive/showduino-0.1/original-time-machine-controller.ino",
    "sceneRecovery": "Named SCENE log checkpoints carry complete scene startup. Clear emergency first, then explicit confirmed restart. Earlier cues are never replayed. Lamp baselines use STEADY_FLAME; scene FX repeat after 2.5 seconds to allow cold ignition."
  }
}
