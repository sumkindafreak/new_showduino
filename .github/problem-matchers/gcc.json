{
  "problemMatcher": [
    {
      "owner": "arduino-gcc",
      "pattern": [
        {
          "regexp": "^([^\\s][^:]*):(\\d+):(\\d+):\\s+(?:fatal )?(error|warning):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
